# Copy to `.env.local` for local development, or set these as
# Cloudflare Pages → Settings → Environment variables (Production + Preview).
# All values are public (shipped to the browser). Never put secrets here.

# Canonical site origin, no trailing slash. Used for canonical/OG URLs, sitemap, robots.
VITE_SITE_URL=https://joinprefix.com

# App Store listing. Leave empty until live — CTAs fall back to the on-page section.
VITE_APP_STORE_URL=

# Deep-link scheme or Universal Link base for /event/:id, /venue/:id, /invite/:code (e.g. prefix://).
VITE_APP_URL_SCHEME=

# Social links. Hidden in the footer while empty.
VITE_INSTAGRAM_URL=
VITE_TIKTOK_URL=

# Contact email. Hidden in the footer while empty.
VITE_CONTACT_EMAIL=

# Invite-code UI on the landing page ("true" | "false"). Default true.
VITE_INVITE_ENABLED=true

# Cloudflare Web Analytics beacon token (optional).
VITE_CF_BEACON_TOKEN=
